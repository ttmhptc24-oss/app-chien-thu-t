# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG & BẢO MẬT (AI AGENT TRADING PLATFORM)
# Đổi tên file này thành .env khi chạy trên máy cá nhân.
# TUYỆT ĐỐI KHÔNG gửi API Secret lên Git hoặc truyền xuống trình duyệt!
# ============================================================================

TRADING_MODE=PAPER_TRADING
ENABLE_LIVE_TRADING=false

# Quản trị rủi ro cứng (Agent 5 - Risk Manager VETO)
MAX_RISK_PER_TRADE_PCT=0.005
MAX_OPEN_RISK_PCT=0.020
MAX_DAILY_LOSS_PCT=0.020
MIN_RR_RATIO=2.0

# Kết nối sàn Binance (Chỉ dùng Read-Only hoặc Spot/Futures Testnet trước)
BINANCE_API_KEY=your_readonly_or_testnet_api_key_here
BINANCE_API_SECRET=your_secret_key_never_expose_to_browser
BINANCE_USE_TESTNET=true

# Kết nối Database & Redis (Tùy chọn khi mở rộng Production)
DATABASE_URL=postgresql://quant_user:quant_pass@localhost:5432/ai_trading_db
REDIS_URL=redis://localhost:6379/0
